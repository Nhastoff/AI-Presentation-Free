{
  "name": "ai-presentation-free",
  "version": "0.3.0",
  "description": "AI Presentation Free — редактор презентаций для Windows и macOS",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "AI Presentation Free contributors",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:desktop": "node tests/desktop-smoke.cjs",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --x64 --arm64 --publish never"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pdfjs-dist": "^6.4.299",
    "pptxgenjs": "^3.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "org.presentationfree.desktop",
    "productName": "AI Presentation Free",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "artifactName": "AI-Presentation-Free-${version}-${os}-${arch}.${ext}",
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "AI-Presentation-Free-${version}-Setup-${arch}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "AI-Presentation-Free-${version}-Portable-${arch}.exe"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "dmg": {
      "title": "AI Presentation Free"
    }
  }
}
